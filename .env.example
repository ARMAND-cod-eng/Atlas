# Atlas configuration.
# Copy to .env at the repository root:  Copy-Item .env.example .env
# This single file serves both the backend (resolved absolutely by atlas/config.py)
# and docker compose (which auto-loads the .env sitting beside docker-compose.yml).

# --- LLM providers -------------------------------------------------------------

# Anthropic API key. Powers the primary model. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key. Only used when the primary model fails and the fallback fires.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily search API key. Reserved for the researcher agents in a later phase.
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Models --------------------------------------------------------------------

# Primary model. Single source of truth for model choice across the whole system.
PRIMARY_MODEL=claude-sonnet-5

# Fallback model, used only when the primary is unavailable or overloaded.
FALLBACK_MODEL=gpt-4o

# --- Infrastructure ------------------------------------------------------------

# Postgres connection string in psycopg form. The SQLAlchemy variant is derived
# from this in config.py, so there is only ever one URL to keep correct.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# Redis connection string. Reserved for caching and rate limiting in a later phase.
REDIS_URL=redis://localhost:6379/0

# --- Runtime -------------------------------------------------------------------

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Upper bound on tokens a single query may consume. Measured and warned on today;
# enforced in Phase 2 alongside the critic loop, which is what makes spend unbounded.
MAX_TOKENS_PER_QUERY=100000

# --- Research graph ------------------------------------------------------------

# Most subtasks the planner may produce. Each becomes one parallel researcher, so
# this is the fan-out width and the main multiplier on cost per query.
MAX_SUBTASKS=5

# Search attempts a single researcher may make. Bounds retries on empty results;
# it is not a budget for open-ended exploration.
MAX_TOOL_CALLS_PER_RESEARCHER=3

# Results requested per web search.
SEARCH_RESULTS_PER_QUERY=5
