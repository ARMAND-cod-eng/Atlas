# Atlas configuration.
# Copy to .env at the repository root:  Copy-Item .env.example .env
# This single file serves both the backend (resolved absolutely by atlas/config.py)
# and docker compose (which auto-loads the .env sitting beside docker-compose.yml).

# --- LLM providers -------------------------------------------------------------

# Anthropic API key. Powers the primary model. Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI API key. Only used when the primary model fails and the fallback fires.
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tavily search API key. The researcher agents' web search. Get one at https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Offline mode: the whole product with no API key. Every model and the web search
# are scripted (backend/atlas/offline.py): answers are built from what the
# regulation library returns, every answer says it was scripted, and the UI marks
# the run. For trying Atlas and for demos, never for a real question. The keys
# above may then be left as they are, or empty.
ATLAS_OFFLINE=false

# --- Models --------------------------------------------------------------------

# Primary model. Single source of truth for model choice across the whole system.
PRIMARY_MODEL=claude-sonnet-5

# Fallback model, used only when the primary is unavailable or overloaded.
FALLBACK_MODEL=gpt-4o

# --- Infrastructure ------------------------------------------------------------

# Postgres connection string in psycopg form. The SQLAlchemy variant is derived
# from this in config.py, so there is only ever one URL to keep correct.
DATABASE_URL=postgresql://atlas:atlas@localhost:5432/atlas

# Redis connection string. Holds the worker's job queue, each run's event stream
# and stored result, and the per-run token budget.
REDIS_URL=redis://localhost:6379/0

# --- Runtime -------------------------------------------------------------------

# Root log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Upper bound on tokens one run (one question) may consume. Checked by the critic
# before each review: a run over budget keeps its current answer, is not reviewed
# or revised further, and reports budget_exceeded. Counted per run, not per
# conversation, so follow-ups on the same thread each get the full budget.
MAX_TOKENS_PER_QUERY=100000

# --- Research graph ------------------------------------------------------------

# What Atlas researches from: "compliance" (the EU AI Act and GDPR, read from the
# regulation library first, web results kept as secondary sources) or "general"
# (web search only, as the first general baseline measured it). The eval sets the
# domain per dataset and ignores this.
ATLAS_DOMAIN=compliance

# Compliance researchers: provisions read from the library per subtask, and web
# results kept beside them (0 turns the web off).
LIBRARY_RESULTS=6
COMPLIANCE_WEB_RESULTS=3

# Whether the compliance critic also has a model read each cited provision against
# the sentence citing it, and send back citations that do not say what they are
# cited for. One structured call per review round.
CITATION_SUPPORT_CHECK=true

# Days a conversation is kept after its last question. A nightly job (03:00) then
# deletes it everywhere: run records, recorded prompts, events, checkpoints.
# DELETE /threads/{id} does the same on request. 0 keeps everything.
RETENTION_DAYS=30

# Most subtasks the planner may produce. Each becomes one parallel researcher, so
# this is the fan-out width and the main multiplier on cost per query.
MAX_SUBTASKS=5

# Search attempts a single researcher may make. Bounds retries on empty results;
# it is not a budget for open-ended exploration.
MAX_TOOL_CALLS_PER_RESEARCHER=3

# Results requested per web search.
SEARCH_RESULTS_PER_QUERY=5

# --- Critic loop -----------------------------------------------------------------

# How many times the critic may send work back. 2, not 5 — the first pass catches
# most errors and returns collapse after two or three, while every extra pass adds
# a re-research plus a full re-synthesis.
MAX_CRITIC_ITERATIONS=2

# Runaway guard on the synthesized answer, not a length target. Latency is
# output-driven (~100 tok/s measured), but the concision rule in the synthesizer
# prompt is what actually shortens the answer — measured 4392 -> 2752 output
# tokens. Caps of 2000 and 3500 both truncated ordinary answers mid-sentence, so
# this sits above the largest output ever observed. A run that trips it reports
# synthesis_truncated in metrics.degraded.
SYNTHESIS_MAX_TOKENS=6000

# --- Streaming -------------------------------------------------------------------

# Heartbeat comment interval on an idle SSE stream, in seconds. Proxies close
# connections that go quiet and a single synthesis call can run 25s in silence.
SSE_HEARTBEAT_SECONDS=15

# How long a finished run's events and result stay readable, in seconds.
EVENT_STREAM_TTL_SECONDS=3600

# Runs the worker executes concurrently. Each is a five-branch fan-out, so treat
# this as a multiplier on provider rate limits rather than a thread count.
WORKER_MAX_JOBS=5
